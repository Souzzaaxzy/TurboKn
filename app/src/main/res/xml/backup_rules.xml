<?xml version="1.0" encoding="utf-8"?>
<!-- Applies to Android 11 and lower, where dataExtractionRules is ignored.
     TurboKn stores no user data, so nothing is backed up. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
